# Cabeceras para Netlify (otros hostings las ignoran).
# Los modelos para los visores de AR del sistema necesitan su tipo MIME exacto.
/assets/*.usdz
  Content-Type: model/vnd.usdz+zip
  Cache-Control: public, max-age=3600

/assets/*.glb
  Content-Type: model/gltf-binary
  Cache-Control: public, max-age=3600

/vendor/*
  Cache-Control: public, max-age=604800
