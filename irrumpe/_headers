# Cabeceras para Netlify (otros hostings las ignoran).
# El modelo para la AR del iPhone (Quick Look) necesita su tipo MIME exacto.
/assets/*.usdz
  Content-Type: model/vnd.usdz+zip
  Cache-Control: public, max-age=3600

/vendor/*
  Cache-Control: public, max-age=604800

# El service worker se revisa en cada visita, para que las actualizaciones lleguen.
/sw.js
  Cache-Control: no-cache
